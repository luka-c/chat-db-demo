{
  "imports": {
    "@db/sqlite": "jsr:@db/sqlite@^0.13.0",
    "@hono/zod-validator": "jsr:@hono/zod-validator@^0.9.1",
    "@std/encoding": "jsr:@std/encoding@^1.0.11",
    "@zod/zod": "jsr:@zod/zod@^4.6.7",
    "hono": "jsr:@hono/hono@^4.13.14",
    "bcrypt": "https://deno.land/x/bcrypt@v0.4.1/mod.ts",
    "@std/testing": "jsr:@std/testing@^1.0.0",
    "@std/expect": "jsr:@std/expect@^1.0.0",
    "@std/assert": "jsr:@std/assert@^1.0.19"
  },
  "tasks": {
    "start": "deno run -A main.ts",
    "dev": "deno run -A --watch main.ts",
    "test": "DB_PATH=:memory: deno test -A"
  },
  "fmt": {
    "singleQuote": false,
    "lineWidth": 80,
    "useTabs": true,
    "semiColons": true,
    "useBraces": "always"
  }
}
